{
  "name": "imgui-studio",
  "version": "0.1.0",
  "description": "A local-first visual feedback loop for AI agents authoring real Dear ImGui interfaces in C++ (Emscripten + WebGL2).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "imgui-studio": "bin/imgui-studio.js"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node bin/imgui-studio.js serve --open",
    "resonance": "node bin/imgui-studio.js serve --project examples/resonance --port 7421 --open",
    "doctor": "node bin/imgui-studio.js doctor",
    "mcp": "node bin/imgui-studio.js mcp",
    "build": "node bin/imgui-studio.js build",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "monaco-editor": "^0.52.2",
    "pngjs": "^7.0.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "playwright-core": "^1.56.1"
  }
}
